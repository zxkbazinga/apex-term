{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ApexTerm",
  "version": "../package.json",
  "identifier": "com.zzbazinga.apex-term",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ApexTerm",
        "width": 1024,
        "height": 760,
        "minWidth": 820,
        "minHeight": 700,
        "backgroundColor": "#050805",
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
